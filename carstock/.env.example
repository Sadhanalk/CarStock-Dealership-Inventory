# Copy to .env (repo root) only if you want to change something. All values are optional.

# Persistent database. Default: SQLite file at backend/data/carstock.db (created automatically).
# DATABASE_URL=sqlite:///./some/other/path.db

# Use a long random string anywhere outside local development.
JWT_SECRET=change-this-in-local-development
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create the demo accounts and sample vehicles on first start.
SEED_DEMO_DATA=true

# Frontend only: set when the API is hosted on a different origin than the site.
# VITE_API_BASE_URL=https://your-api.example.com/api
